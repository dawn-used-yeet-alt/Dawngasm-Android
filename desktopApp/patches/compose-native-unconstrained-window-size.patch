From 753607193b4d61e5d2dbe899e782a4a4315903b1 Mon Sep 17 00:00:00 2001
From: Dawnusedyeet <I_use@arch.btw>
Date: Tue, 17 Nov 2026 10:09:50 +0530
Subject: [PATCH 3/3] fix(desktop-native): use proportional floating window
 defaults on Windows and macOS

---
 .../compose/ui/window/Window.desktopNative.kt    | 16 ++++++++++++++--
 1 file changed, 14 insertions(+), 2 deletions(-)

diff --git a/compose/desktop/desktop-native/src/desktopNativeMain/kotlin/androidx/compose/ui/window/Window.desktopNative.kt b/compose/desktop/desktop-native/src/desktopNativeMain/kotlin/androidx/compose/ui/window/Window.desktopNative.kt
index f7b465c9..b602cc16 100644
--- a/compose/desktop/desktop-native/src/desktopNativeMain/kotlin/androidx/compose/ui/window/Window.desktopNative.kt
+++ b/compose/desktop/desktop-native/src/desktopNativeMain/kotlin/androidx/compose/ui/window/Window.desktopNative.kt
@@ -2924,7 +2924,13 @@ internal class NativeWindowHost(
                 val w = usableBounds.w
                 val h = usableBounds.h
                 if (w > 0 && h > 0) {
-                    return Pair(w, h)
+                    return if (IsLinuxHost) {
+                        Pair(w, h)
+                    } else {
+                        val targetW = (w * 0.75f).roundToInt().coerceIn(800, 1280)
+                        val targetH = (h * 0.75f).roundToInt().coerceIn(600, 800)
+                        Pair(targetW, targetH)
+                    }
                 }
             }
             val mode = SDL_GetCurrentDisplayMode(display)
@@ -2932,7 +2938,13 @@ internal class NativeWindowHost(
                 val w = mode.pointed.w
                 val h = mode.pointed.h
                 if (w > 0 && h > 0) {
-                    return Pair(w, h)
+                    return if (IsLinuxHost) {
+                        Pair(w, h)
+                    } else {
+                        val targetW = (w * 0.75f).roundToInt().coerceIn(800, 1280)
+                        val targetH = (h * 0.75f).roundToInt().coerceIn(600, 800)
+                        Pair(targetW, targetH)
+                    }
                 }
             }
         }
-- 
